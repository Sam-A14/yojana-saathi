{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document catalogue (data/documents.json)",
  "type": "object",
  "required": [
    "documents"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "code",
        "name_en",
        "name_hi"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable machine name. Never rename once used: rules and member records refer to it."
        },
        "name_en": {
          "type": "string",
          "minLength": 1
        },
        "name_hi": {
          "type": "string",
          "minLength": 1
        },
        "how_to_get_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "how_to_get_hi": {
          "type": [
            "string",
            "null"
          ]
        },
        "official_link": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        }
      }
    }
  }
}
