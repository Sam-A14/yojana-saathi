# Browser origin allowed to call this API (CORS). No trailing slash.
FRONTEND_URL=http://localhost:3000
# Optional: also allow one Vercel project's preview deployments (set BOTH or neither). These are the
# project and team slugs in its URLs: https://<project>-<hash>-<team>.vercel.app
# VERCEL_PROJECT=
# VERCEL_TEAM=
# Optional: overrides the version reported by /health.
# APP_VERSION=0.1.0

# PostgreSQL connection string. Paste Neon's string as-is ("postgresql://..."); the code converts it
# to the driver form. On Neon use the direct (non-pooled) connection. Not needed for /health.
# DATABASE_URL=postgresql://user:password@localhost:5432/yojana
# Used only by pytest. The database name MUST end in "_test": the tests wipe it.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/yojana_test

# LLM used only by the rule-extraction job (python -m app.pipeline.extract_cli <slug>).
# LLM_PROVIDER picks the implementation: "gemini" (default) or "fake" (tests only).
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.6-flash  (empty or unset also means this default)
# LLM_API_KEY=

# Sign-in by email (one-time codes). Never commit real values.
# Long random text, 32+ characters. Signs the stored hash of every code; changing it makes waiting
# codes stop working. Make one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET=
# Resend API key (https://resend.com). Not needed when EMAIL_PROVIDER=fake.
# RESEND_API_KEY=
# The sender shown on the email. The default only delivers to your own Resend account's address;
# to email anyone else, verify a domain with Resend and use an address on it (README, "Going live
# with a custom domain").
# EMAIL_FROM=Yojana Saathi <onboarding@resend.dev>
# "resend" (default) or "fake" (tests only: keeps messages in memory, sends nothing).
# EMAIL_PROVIDER=resend
# Most sign-in codes sent per UTC day, to protect Resend's free quota (about 100 a day).
# EMAIL_DAILY_LIMIT=80

