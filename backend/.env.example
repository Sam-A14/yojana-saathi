# Browser origin allowed to call this API (CORS). No trailing slash.
FRONTEND_URL=http://localhost:3000
# Optional: also allow one Vercel project's preview deployments (set BOTH or neither). These are the
# project and team slugs in its URLs: https://<project>-<hash>-<team>.vercel.app
# VERCEL_PROJECT=
# VERCEL_TEAM=
# Optional: overrides the version reported by /health.
# APP_VERSION=0.1.0

# PostgreSQL connection string. Paste Neon's string as-is ("postgresql://..."); the code converts it
# to the driver form. On Neon use the direct (non-pooled) connection. Not needed for /health.
# DATABASE_URL=postgresql://user:password@localhost:5432/yojana
# Used only by pytest. The database name MUST end in "_test": the tests wipe it.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/yojana_test

# LLM used only by the rule-extraction job (python -m app.pipeline.extract_cli <slug>).
# LLM_PROVIDER picks the implementation: "gemini" (default) or "fake" (tests only).
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.6-flash  (empty or unset also means this default)
# LLM_API_KEY=
